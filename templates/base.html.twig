<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Bot Arena · SymfonyCon Live{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏁</text></svg>">
    {% block javascripts %}{{ importmap(['app', 'arena']) }}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
<header class="top">
    <div class="wrap">
        <a class="brand" href="{{ path('home') }}">🏁 SymfonyCon <b>Bot Arena</b></a>
        <nav>
            <a href="{{ path('home') }}">Arena</a>
            <a href="{{ path('merch') }}">🎁 Merch</a>
        </nav>
    </div>
</header>
<main class="wrap">
    {% block body %}{% endblock %}
</main>
<footer class="wrap muted">Every bot here was built live by a SymfonyCon attendee with an AI agent in PhpStorm Air, at the booth.</footer>
</body>
</html>
