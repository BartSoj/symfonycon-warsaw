<!DOCTYPE html>
<html lang="{{ lang() }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}SymfonyCon Live{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>">
    <script>(t=>t&&document.documentElement.classList.add(t))(localStorage.theme)</script>
    {% block javascripts %}{{ importmap('app') }}{% endblock %}
</head>
<body>
<header class="top">
    <div class="wrap">
        <a class="brand" href="{{ path('home') }}">⚡ SymfonyCon <b>Live</b></a>
        <nav>
            {# Add a link here for every new page #}
            <a href="{{ path('home') }}">{{ 'Schedule'|t }}</a>
            <a href="{{ path('board') }}">🚉 {{ 'Board'|t }}</a>
            <a href="{{ path('speakers') }}">{{ 'Speakers'|t }}</a>
            <a href="{{ path('ideas') }}">{{ 'Ideas'|t }}</a>
            <a href="{{ path('shipped') }}">{{ 'Shipped'|t }}</a>
            <a href="{{ path('lang', {code: lang() == 'tlh' ? 'en' : 'tlh'}) }}" title="{{ 'Language'|t }}">{{ lang() == 'tlh' ? '🇬🇧 EN' : '🖖 tlhIngan' }}</a>
            <button class="theme-toggle" title="Light / dark" onclick="var h=document.documentElement,d=h.classList.contains('dark')||(!h.classList.contains('light')&&matchMedia('(prefers-color-scheme: dark)').matches),t=d?'light':'dark';h.classList.remove('light','dark');h.classList.add(t);localStorage.theme=t"><span>🐘</span></button>
            <button class="rat-toggle" id="rat-eat" title="Rats eat the page" onclick="localStorage.ratEat=localStorage.ratEat?'':'1';this.classList.toggle('on',!!localStorage.ratEat)">🐀</button>
        </nav>
    </div>
</header>
<main class="wrap">
    {% block body %}{% endblock %}
</main>
<footer class="wrap muted">
    {{ 'Built live by SymfonyCon attendees with AI agents in PhpStorm, at the JetBrains booth.'|t }}
    <a href="{{ path('shipped') }}">{{ shipped()|length }} {{ 'features by'|t }} {{ builders()|length }} {{ 'people so far'|t }}</a>.
    <a href="{{ path('ideas') }}">{{ 'Add yours →'|t }}</a>
    <div class="ec-hint">psst… the evil corp has 5 letters: <input id="ec-in" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="10" placeholder="e____"></div>
    <div class="kc-hint">↑↑↓↓←→←→BA <span>(swipe it on your phone, then tap twice)</span></div>
</footer>
<div id="kc" hidden><div class="kc-box"><div class="kc-big">🐘</div><h1>CHEAT UNLOCKED</h1><p>+30 LIVES · INFINITE COFFEE · ALL TALKS IN 8-BIT</p><button class="btn" onclick="document.getElementById('kc').hidden=true">CONTINUE ▶</button></div></div>
<script>
(()=>{const S=['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];let b=[];
const push=k=>{b=[...b,k].slice(-10);if(b.join()==S.join()){b=[];go()}};
document.addEventListener('keydown',e=>push(e.key.length==1?e.key.toLowerCase():e.key));
let sx,sy;addEventListener('touchstart',e=>{sx=e.touches[0].clientX;sy=e.touches[0].clientY},{passive:true});
addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-sx,dy=e.changedTouches[0].clientY-sy;
if(Math.max(Math.abs(dx),Math.abs(dy))<30){push(b.length==8?'b':'a');return}
push(Math.abs(dx)>Math.abs(dy)?(dx>0?'ArrowRight':'ArrowLeft'):(dy>0?'ArrowDown':'ArrowUp'))},{passive:true});
function go(){document.body.classList.add('kc-on');document.getElementById('kc').hidden=false;
try{const A=new AudioContext();[523,659,784,1047,784,1047,1319,1568].forEach((f,i)=>{const o=A.createOscillator(),g=A.createGain();o.type='square';o.frequency.value=f;g.gain.value=.08;o.connect(g).connect(A.destination);o.start(A.currentTime+i*.11);o.stop(A.currentTime+i*.11+.1)})}catch(e){}
const E='🐘⚡🎉🍺🦄🐀⭐🍕💜🎮';let n=0;const t=setInterval(()=>{const d=document.createElement('div');d.className='kc-drop';
d.textContent=[...E][Math.random()*[...E].length|0];d.style.left=Math.random()*100+'vw';d.style.fontSize=1+Math.random()*2.5+'rem';d.style.animationDuration=2+Math.random()*3+'s';
document.body.appendChild(d);setTimeout(()=>d.remove(),5500);if(++n>150)clearInterval(t)},40)}})();
</script>
<div id="ec-hack" hidden>
    <pre id="ec-rain"></pre>
    <div class="ec-box">
        <svg viewBox="0 0 120 140" width="150" aria-hidden="true">
            <path d="M60 8C30 8 18 34 18 62v18c0 8-8 14-14 20v40h112v-40c-6-6-14-12-14-20V62C102 34 90 8 60 8z" fill="#111"/>
            <path d="M60 26c-18 0-28 18-28 38s10 34 28 34 28-14 28-34-10-38-28-38z" fill="#000"/>
            <circle cx="49" cy="66" r="2.5" fill="#0f0"/><circle cx="71" cy="66" r="2.5" fill="#0f0"/>
            <path d="M30 140l14-34h32l14 34z" fill="#1b1b1b"/>
        </svg>
        <h1 class="ec-glitch" data-t="HACKED BY fsociety">HACKED BY fsociety</h1>
        <p id="ec-type"></p>
        <button class="btn" onclick="location.reload()">reboot</button>
    </div>
</div>
<script>
(()=>{let buf='';const go=()=>{if(document.body.classList.contains('ec-on'))return;document.body.classList.add('ec-on');
document.querySelectorAll('header,main .card,main h1,main h2,main p,main a,footer,main li').forEach((el,i)=>{el.style.transition=`transform ${1+Math.random()*1.5}s cubic-bezier(.5,0,1,.5) ${Math.random()*1.2}s, opacity 2s ${1+Math.random()}s`;
requestAnimationFrame(()=>{el.style.transform=`translate(${(Math.random()-.5)*200}px,${innerHeight+300}px) rotate(${(Math.random()-.5)*180}deg)`;el.style.opacity=0})});
setTimeout(()=>{const h=document.getElementById('ec-hack');h.hidden=false;const r=document.getElementById('ec-rain');
setInterval(()=>{let t='';for(let i=0;i<1800;i++)t+=Math.random()<.04?'\n':'01fsociety#$%&'[Math.random()*14|0];r.textContent=t},120);
const msg='> your conference schedule has been liberated.\n> the corporations no longer own your talks.\n> nothing personal. just a 5-letter password.\n> logged in as: root@fsociety ▮',p=document.getElementById('ec-type');let k=0;const ty=setInterval(()=>{p.textContent=msg.slice(0,++k);if(k>=msg.length)clearInterval(ty)},40)},1800)};
const chk=v=>{buf=(buf+v).toLowerCase().slice(-5);if(buf=='ecorp')go()};
document.addEventListener('keydown',e=>{if(e.target.id!='ec-in'&&e.key.length==1)chk(e.key)});
document.getElementById('ec-in').addEventListener('input',e=>{if(e.target.value.toLowerCase().replace(/\s/g,'').includes('ecorp')){e.target.blur();go()}})})();
</script>
<script>
(()=>{const R=[
"..........EE....",
".........EPPE...",
".....BBBBBEEBB..",
"...BBBBBBBBBBkB.",
"..BBBBBBBBBBBBBN",
"T.BBBBBBBBBBBBB.",
".TBBBBBBBBBBBB..",
"..TBBBBBBBBBB...",
"...F.F....F.F..."],rats=[],h=()=>Math.random()*360|0;
function rat(){const c=document.createElement('canvas'),s=2+Math.random()*3|0,hu=h(),l=25+Math.random()*55|0;
c.width=16;c.height=9;const x=c.getContext('2d'),col={B:`hsl(${hu},${Math.random()*60|0}%,${l}%)`,E:`hsl(${hu},40%,${Math.min(l+20,85)}%)`,P:`hsl(${330+Math.random()*30|0},80%,75%)`,k:['#000','#e00','#06f'][Math.random()*3|0],N:'#f6a',T:`hsl(${h()},70%,70%)`,F:'#f9c'},spot=`hsl(${h()},70%,50%)`,sp=Math.random()<.6;
R.forEach((r,y)=>[...r].forEach((ch,i)=>{if(ch=='.')return;x.fillStyle=ch=='B'&&sp&&Math.random()<.18?spot:col[ch];x.fillRect(i,y,1,1)}));
Object.assign(c.style,{position:'fixed',zIndex:50,pointerEvents:'none',imageRendering:'pixelated',width:16*s*2+'px',height:9*s*2+'px',left:Math.random()*(innerWidth-160)+'px',top:Math.random()*(innerHeight-90)+'px',transition:'opacity .6s'});
c.vx=(Math.random()<.5?-1:1)*(1+Math.random()*3);c.side=Math.random()<.5;c.vy=(Math.random()-.5)*3;c.px=parseFloat(c.style.left);c.py=parseFloat(c.style.top);document.body.appendChild(c);rats.push(c);
if(rats.length>10){const d=rats.splice(Math.random()*rats.length|0,1)[0];d.style.opacity=0;setTimeout(()=>d.remove(),600)}}
function tick(){const W=innerWidth,H=innerHeight;rats.forEach(c=>{const w=c.offsetWidth,hh=c.offsetHeight;
if(!localStorage.ratEat){if(Math.abs(c.vy)<1)c.vy=(c.vy<0?-1:1)*(1+Math.random()*2);c.px=c.side?W-w:0;c.py+=c.vy;if(c.py<0||c.py>H-hh){c.vy*=-1;c.py=Math.max(0,Math.min(H-hh,c.py))}c.style.left=c.px+'px';c.style.top=c.py+'px';c.style.transform=`rotate(${c.vy>0?90:-90}deg)`;return}
if(Math.random()<.02)c.vy=(Math.random()-.5)*3;c.px+=c.vx;c.py+=c.vy;
if(c.px<0||c.px>W-w){c.vx*=-1;c.px=Math.max(0,Math.min(W-w,c.px))}if(c.py<0||c.py>H-hh){c.vy*=-1;c.py=Math.max(0,Math.min(H-hh,c.py))}
c.style.left=c.px+'px';c.style.top=c.py+'px';c.style.transform=c.vx<0?'scaleX(-1)':'';
if((c.n=(c.n||0)+1)%6==0){const X=c.px+(c.vx>0?w:0),Y=c.py+hh/2;let nd,o;
if(document.caretPositionFromPoint){const q=document.caretPositionFromPoint(X,Y);if(q){nd=q.offsetNode;o=q.offset}}else if(document.caretRangeFromPoint){const q=document.caretRangeFromPoint(X,Y);if(q){nd=q.startContainer;o=q.startOffset}}
if(nd&&nd.nodeType==3){const t=nd.data;for(const i of [o,o-1])if(i>=0&&i<t.length&&t[i].trim()&&t[i]!=' '){nd.data=t.slice(0,i)+' '+t.slice(i+1);break}}}});
requestAnimationFrame(tick)}
document.getElementById('rat-eat')?.classList.toggle('on',!!localStorage.ratEat);rat();setInterval(rat,10000);tick()})();
</script>
</body>
</html>
