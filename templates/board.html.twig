{% extends 'base.html.twig' %}
{% block title %}{{ 'Board'|t }} · SymfonyCon Live{% endblock %}
{% block body %}
<div class="pkp">
    <div class="pkp-clock" id="clock">--:--:--</div>
    <div class="pkp-date" id="date"></div>
    <button class="btn" id="tts">🔊 Włącz zapowiedzi / Enable announcements</button>
    <h2 class="pkp-h">▶ Teraz / Now</h2>
    <div id="now"></div>
    <h2 class="pkp-h">⏭ Następne / Next</h2>
    <div id="next"></div>
</div>
<script>
(()=>{const T={{ talks|json_encode|raw }}.map(t=>({...t,s:new Date(t.start),e:new Date(t.end)})),tz='Europe/Warsaw';
const hm=d=>d.toLocaleTimeString('pl-PL',{timeZone:tz,hour:'2-digit',minute:'2-digit'});
const row=t=>`<div class="pkp-row"><span class="pkp-time">${hm(t.s)}</span><span class="pkp-title">${t.title}<small>${t.speakers||''}</small></span><span class="pkp-room">${t.room||''}</span></div>`;
let on=false,said=new Set();
function ding(){try{const a=new AudioContext();[[659,0],[523,.45]].forEach(([f,d])=>{const o=a.createOscillator(),g=a.createGain();o.frequency.value=f;o.connect(g);g.connect(a.destination);g.gain.setValueAtTime(.3,a.currentTime+d);g.gain.exponentialRampToValueAtTime(.001,a.currentTime+d+.8);o.start(a.currentTime+d);o.stop(a.currentTime+d+.9)})}catch(e){}}
function say(txt){ding();setTimeout(()=>{const u=new SpeechSynthesisUtterance(txt);u.lang='en-GB';u.rate=.95;speechSynthesis.speak(u)},1300)}
const ann=(t,now)=>`Attention please. ${now?'Now in progress':'Coming up at '+hm(t.s)}${t.room?', in '+t.room:''}: ${t.title}${t.speakers?', by '+t.speakers:''}.`;
function upd(){const n=new Date();clock.textContent=n.toLocaleTimeString('pl-PL',{timeZone:tz});
date.textContent=n.toLocaleDateString('pl-PL',{timeZone:tz,weekday:'long',day:'numeric',month:'long'});
const cur=T.filter(t=>t.s<=n&&t.e>n),up=T.filter(t=>t.s>n),nx=up.length?up.filter(t=>+t.s==+up[0].s||t.s<new Date(+up[0].s+36e5)).slice(0,6):[];
const h=cur.map(row).join('')||'<p class="muted">—</p>';if(window.nowH!==h)now.innerHTML=window.nowH=h;
const h2=nx.map(row).join('')||'<p class="muted">—</p>';if(window.nxH!==h2)next.innerHTML=window.nxH=h2;
if(on)[...cur.map(t=>[t,1]),...up.filter(t=>t.s-n<3e5).map(t=>[t,0])].forEach(([t,c])=>{const k=t.title+c;if(!said.has(k)){said.add(k);say(ann(t,c))}});
return [cur,nx]}
tts.onclick=()=>{on=true;tts.textContent='🔊 Zapowiedzi włączone';const [c,x]=upd();(c.length?c.map(t=>[t,1]):x.slice(0,1).map(t=>[t,0])).forEach(([t,k])=>{said.add(t.title+k);say(ann(t,k))})};
upd();setInterval(upd,1000)})();
</script>
{% endblock %}
