{% extends 'base.html.twig' %}

{% block title %}{{ bot.name }} · Bot Arena{% endblock %}

{% block body %}
    <h1><span class="swatch big" style="background: {{ bot.color }}"></span> {{ bot.name }}</h1>
    <p class="muted">by {{ bot.author }} · #{{ rank }} on the leaderboard · Elo {{ bot.elo }} · {{ bot.wins }} wins, {{ bot.losses }} losses, {{ bot.draws }} draws</p>
    {% if not bot.house %}
        <form method="post" action="{{ path('bot_toggle', {name: bot.key}) }}" class="card entry {{ bot.enabled ? 'on' }}">
            {% if bot.enabled %}
                <p><b>🏁 In the arena.</b> It plays everyone's bots on the TV and is on the leaderboard.</p>
                <button class="btn btn-outline">Back to the garage</button>
            {% else %}
                <p><b>🔧 In the garage.</b> It only plays The House: its trial and your test matches. Nobody else's bot gets in the way.</p>
                <button class="btn">🏁 Enter the arena</button>
            {% endif %}
        </form>
    {% endif %}
    {% if bot.problem %}<div class="card warn">⚠️ {{ bot.problem }}</div>{% endif %}

    {% if trial %}
        <div class="card trial {{ trial.passed ? 'passed' : (trial.tshirt ? 'tshirt') }}">
            {% if trial.passed %}
                <p class="big">🧥 Hoodie earned!</p>
                <p>{{ bot.name }} beat The House {{ trial.wins }} out of 3. Show this screen at the booth.</p>
            {% elseif trial.tshirt %}
                <p class="big">👕 T-shirt earned!</p>
                <p>{{ bot.name }} won {{ trial.wins }}/3 and survived up to {{ trial.survived }} ticks. Show this screen at the booth.
                    Win 2 of 3 for the hoodie: ask the agent to make it smarter, and every new version gets a new trial.</p>
            {% else %}
                <p class="big">{{ trial.wins }}/3 against The House</p>
                <p>It survived {{ trial.survived }} ticks at most. Survive {{ constant('App\\Arena\\League::SURVIVE') }} or win one match for a T-shirt, and win 2 for the hoodie.</p>
            {% endif %}
            <div class="trial-games">
                {% for game in trial.games %}
                    <a href="{{ path('game', {id: game.id}) }}">{{ game.winner == bot.id ? '✅ win' : (game.winner ? '❌ loss' : '🤝 draw') }}</a>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if not bot.house %}
        <h2>Test it</h2>
        {% set first = trial.games|first %}
        <div class="arena" data-arena {% if first %}data-game="{{ first.forPlayer|json_encode }}"{% endif %}></div>
        <p class="row"><a class="btn" href="{{ path('bot_practice', {name: bot.key}) }}" data-arena-next>▶ Test match vs The House</a> <span class="muted">Random arena, not counted.</span></p>
    {% endif %}

    <h2>Recent matches</h2>
    {% for game in recent %}
        {% set me = game.replay.players[0].key == bot.key ? 0 : 1 %}
        {% set them = game.replay.players[1 - me] %}
        <a class="card" href="{{ path('game', {id: game.id}) }}">
            {{ game.replay.winner is same as(me) ? '✅' : (game.replay.winner is null ? '🤝' : '❌') }}
            vs <b>{{ them.name }}</b> <span class="muted">by {{ them.author }}{{ game.trial ? ' · trial' }} · {{ game.playedAt|date('H:i') }}</span>
        </a>
    {% else %}
        <p class="muted">No matches yet. Watch the TV, it'll be on soon.</p>
    {% endfor %}

    <h2>The code</h2>
    <pre class="code">{{ source }}</pre>
{% endblock %}
