{% extends 'base.html.twig' %}

{% block title %}Match #{{ game.id }} · Bot Arena{% endblock %}

{% block body %}
    <h1>Match #{{ game.id }}{{ game.trial ? ' · trial vs The House' }}</h1>
    <p class="muted">{{ game.playedAt|date('l H:i') }}</p>
    <div class="arena" data-arena data-game="{{ game.forPlayer|json_encode }}"></div>
    <p class="row">
        {% for p in game.replay.players %}<a class="btn-outline btn" href="{{ path('bot', {name: p.key}) }}">{{ p.name }}</a>{% endfor %}
    </p>
{% endblock %}
