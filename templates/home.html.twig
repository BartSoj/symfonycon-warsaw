{% extends 'base.html.twig' %}

{% block body %}
    <a class="card finale-banner" href="{{ path('finale_live') }}" data-countdown="{{ finaleAt|date('c') }}" data-now="{{ 'now'|date('U') }}">
        🏁 <b>The Grand Finale</b> · every bot on one arena at {{ finaleAt|date('H:i', 'Europe/Warsaw') }}
        <span class="finale-banner-time" data-countdown-text>Watch live</span> <span class="btn">Watch ▶</span>
    </a>
    <section class="hero">
        <h1>Build a bot, <span class="accent">beat The House.</span></h1>
        {% include '_rewards.html.twig' %}
        <details class="how">
            <summary>How it works</summary>
            <p>Light cycles leave a trail. Hit a trail, a wall or the edge and you crash; the last one riding wins.</p>
            <ol class="steps">
                <li>At the booth, tell the agent in <b>PhpStorm Air</b> your strategy, a bot name and a colour.</li>
                <li>It ships your bot, which plays 3 trial matches against <b>The House</b> on the TV.</li>
                <li>Find your bot under “In the garage” below, run test matches, and enter it in the arena.</li>
            </ol>
        </details>
    </section>

    {% if latest %}
        <h2>Latest match</h2>
        <div class="arena" data-arena data-game="{{ latest.forPlayer|json_encode }}"></div>
        <p class="row"><a class="btn" href="#" data-arena-next>▶ Play a new match</a> <a class="muted" href="{{ path('game', {id: latest.id}) }}">Replay #{{ latest.id }}</a></p>
    {% endif %}

    <h2>Leaderboard</h2>
    <p class="muted">Elo rating · wins–losses–draws. A new version of a bot starts again from 1000.</p>
    {% include '_leaderboard.html.twig' with {rows: rows|filter(r => r.enabled)} %}
    {% set garage = rows|filter(r => not r.enabled) %}
    {% if garage %}
        <h2>🔧 In the garage</h2>
        <p class="muted">New bots start here: they only play The House until their owner enters them in the arena. Tap yours.</p>
        {% include '_leaderboard.html.twig' with {rows: garage, compact: true} %}
    {% endif %}

    <h2>Need a strategy?</h2>
    {% for idea in ideas() %}
        <div class="card"><b>{{ idea.title }}</b> <span class="tag">{{ idea.level }}</span><br><span class="muted">{{ idea.pitch }}</span></div>
    {% endfor %}
{% endblock %}
