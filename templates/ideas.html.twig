{% extends 'base.html.twig' %}

{% block title %}{{ 'Ideas'|t }} · SymfonyCon Live{% endblock %}

{% block body %}
    <h1>{{ 'What should we build next?'|t }}</h1>
    <p>Come to the <b>JetBrains booth</b>, pick an idea or bring your own, and an AI agent in PhpStorm builds it while you watch.
        It goes live on this site a few minutes later, with your name on it.</p>

    {% for idea in ideas() %}
        <div class="card idea{{ idea.shipped ? ' done' }}">
            <span class="tag">{{ idea.shipped ? '✓ shipped' : idea.level }}</span>
            <b>{{ idea.title }}</b>
            <p class="muted">{{ idea.pitch }}</p>
        </div>
    {% endfor %}
{% endblock %}
