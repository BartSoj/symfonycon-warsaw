{% extends 'base.html.twig' %}

{% block title %}{{ 'Speakers'|t }} · SymfonyCon Live{% endblock %}

{% block body %}
    <h1>{{ 'Speakers'|t }}</h1>
    <input type="search" id="speaker-search" class="speaker-search" placeholder="Search speakers…" autocomplete="off" autofocus>
    <p class="muted" id="speaker-count">{{ speakers|length }} speakers</p>

    <div id="speaker-list">
    {% for speaker, talks in speakers %}
        <div class="card speaker" data-name="{{ speaker|lower }}">
            <b class="speaker-name">{{ speaker }}</b>
            {% for talk in talks %}
                <div><a href="{{ path('home') }}#{{ talk.slug }}">{{ talk.title }}</a>
                    <span class="muted">· {{ talk.startsAt|date('D H:i') }}{% if talk.room %} · {{ talk.room }}{% endif %}</span></div>
            {% endfor %}
        </div>
    {% endfor %}
    </div>

    <script>
        const input = document.getElementById('speaker-search');
        const cards = [...document.querySelectorAll('.speaker')];
        const list = document.getElementById('speaker-list');
        input.focus();
        input.addEventListener('input', () => {
            const q = input.value.trim().toLowerCase();
            const hits = [], rest = [];
            cards.forEach(c => {
                const match = q !== '' && c.dataset.name.includes(q);
                c.classList.toggle('hit', match);
                c.classList.toggle('dim', q !== '' && !match);
                (match ? hits : rest).push(c);
            });
            list.append(...hits, ...rest);
            document.getElementById('speaker-count').textContent = q ? hits.length + ' matching' : cards.length + ' speakers';
        });
    </script>
{% endblock %}
