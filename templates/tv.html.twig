{% extends 'base.html.twig' %}

{% block title %}SymfonyCon Live {{ 'on TV'|t }}{% endblock %}

{% block body %}
    <meta http-equiv="refresh" content="20">
    <div class="tv">
        <div class="tv-qr">
            <img src="{{ qr }}" alt="QR code to {{ url }}">
            <p><b>Scan, then tell the agent what to build.</b><br><span class="muted">{{ url }}</span></p>
            <script type="module" src="https://cdn.jsdelivr.net/npm/@google/model-viewer@4.4.0/dist/model-viewer.min.js"></script>
            <p style="font-size:1.5rem;margin:18px 0 0"><b>🎁 Get your Alt+Enter fidget toy here!</b></p>
            <model-viewer src="/model.glb" alt="Alt+Enter fidget toy" camera-controls auto-rotate shadow-intensity="1" tone-mapping="neutral" camera-orbit="auto 70deg 80%" min-camera-orbit="auto auto 30%" style="width:100%;height:max(340px, calc(100vh - 730px))"></model-viewer>
        </div>
        <div>
            <p class="big"><b>{{ shipped()|length }}</b> features shipped by <b>{{ builders()|length }}</b> SymfonyCon attendees</p>
            <h2>{{ 'Just shipped'|t }}</h2>
            {% for feature in shipped()|slice(0, 5) %}
                <div class="card"><b>{{ feature.title }}</b> <span class="muted">· {{ feature.by }} · {{ feature.at|date('H:i') }}</span></div>
            {% else %}
                <div class="card muted">Nothing yet. Yours could be first.</div>
            {% endfor %}
            <h2>{{ 'Up for grabs'|t }}</h2>
            {% for idea in ideas()|filter(i => not i.shipped)|slice(0, 4) %}
                <div class="card"><b>{{ idea.title }}</b> <span class="muted">· {{ idea.pitch }}</span></div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
