{% extends 'base.html.twig' %}

{% block title %}Bot Arena on TV{% endblock %}
{% block body_class %}tv-page{% endblock %}

{% block body %}
    <div class="tv">
        <div class="tv-side">
            <img class="qr" src="{{ qr }}" alt="QR code to {{ url }}">
            <p class="tv-pitch"><b>Build a bot,<br><span class="accent">beat The House.</span></b></p>
            {% include '_rewards.html.twig' %}
            <p class="muted">Tell the agent in PhpStorm Air your strategy. Scan to see your bot.</p>
            <script type="module" src="https://cdn.jsdelivr.net/npm/@google/model-viewer@4.4.0/dist/model-viewer.min.js"></script>
            <p class="tv-merch-title">🎁 Also here: <span id="tv-merch-name">{{ merch[0].name }}</span></p>
            <model-viewer id="tv-merch" src="{{ merch[0].model }}" alt="JetBrains booth merch" auto-rotate auto-rotate-delay="0" rotation-per-second="40deg" shadow-intensity="1" tone-mapping="neutral" camera-orbit="{{ merch[0].orbit }}" min-camera-orbit="auto auto 30%"></model-viewer>
            <script>
            (()=>{const M={{ merch|json_encode|raw }},v=document.getElementById('tv-merch'),n=document.getElementById('tv-merch-name');
            M.forEach(m=>fetch(m.model));{# warm the cache so switching is instant #}
            const show=()=>{const m=M[Math.floor(Date.now()/6000)%M.length];if(v.getAttribute('src')!=m.model){v.setAttribute('camera-orbit',m.orbit);v.setAttribute('src',m.model);n.textContent=m.name}};
            show();setInterval(show,1000)})();
            </script>
        </div>
        <div class="tv-main">
            <div class="arena" data-arena data-loop="{{ path('arena_next') }}" data-board="{{ path('tv_board') }}"></div>
        </div>
        <div class="tv-board">
            <h2>Leaderboard</h2>
            <div id="tv-board">{% include '_leaderboard.html.twig' with {rows: rows, compact: true} %}</div>
            <p class="muted">🏆 beat The House</p>
        </div>
    </div>
{% endblock %}
